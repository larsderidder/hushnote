# HushNote configuration
# Copy this file to .hushnoterc and edit to your needs.
# This file is sourced as bash, so standard shell syntax applies.

# Directory where recordings are stored
# Default: ./recordings (relative to the hushnote directory)
#RECORDINGS_DIR="${HOME}/meeting-notes"

# Whisper model size: tiny, base, small, medium, large-v3
# Larger models are more accurate but slower and use more memory.
# Default: base
#WHISPER_MODEL=base

# Language code for transcription, e.g. nl, en, de, fr
# Omit or leave empty to auto-detect.
#WHISPER_LANGUAGE=

# Ollama model for summarization
# Default: llama3.1:8b
#OLLAMA_MODEL=llama3.1:8b

# Ollama API URL
# Default: http://localhost:11434
#OLLAMA_URL=http://localhost:11434

# Audio recording backend: ffmpeg or pw-record
# Use pw-record for Bluetooth headsets (HSP/HFP mode via PipeWire).
# Default: ffmpeg
#RECORD_BACKEND=ffmpeg

# Audio source type: mic, sink, or both
#   mic   — microphone input only
#   sink  — system audio (sink monitor) only, captures what plays through speakers
#   both  — mix mic and sink monitor (useful for recording calls)
# Default: mic
#AUDIO_SOURCE_TYPE=mic

# Unload Ollama models before transcription to free VRAM for Whisper.
# Set to 1 if you run into out-of-memory errors during transcription.
# Default: unset (disabled)
#UNLOAD_OLLAMA=1

# Maximum seconds for the process/process-last commands before timing out.
# Default: 7200 (2 hours)
#PROCESS_TIMEOUT=7200

# Optional defaults for unattended catchup runs.
#HUSHNOTE_CATCHUP_DAYS=3
#HUSHNOTE_CATCHUP_MIN_AGE=300
#HUSHNOTE_CATCHUP_LOCK=/tmp/hushnote-catchup.lock

# Silence detection threshold in dB for tail trimming.
# More negative = stricter (only very quiet audio counts as silence).
# Default: -35
#TRIM_NOISE_DB=-35

# Minimum continuous silence duration in seconds to consider a tail silent.
# Default: 60
#TRIM_MIN_SILENCE=60

# Live startup audio watchdog during recording.
# Warns once if a selected audio source stays silent at startup.
# Once sound is detected for a source, that monitor exits and will not warn again.
# With AUDIO_SOURCE_TYPE=both, microphone and meeting output are checked separately.
#HUSHNOTE_AUDIO_MONITOR=true
#HUSHNOTE_AUDIO_MONITOR_GRACE=20
#HUSHNOTE_AUDIO_MONITOR_INTERVAL=30
#HUSHNOTE_AUDIO_MONITOR_SAMPLE=3
#HUSHNOTE_AUDIO_MONITOR_WARN_AFTER=2
#HUSHNOTE_AUDIO_SILENCE_MAX_DB=-60

# Post-summary hook: path to an executable that runs after every summary is created.
# Receives the summary file path as $1.
# On success, hushnote writes a .hook_done marker so the hook is not re-run.
# Use this to integrate with Outline, Notion, a webhook, or any other destination.
#
# Example using the bundled hushnote-to-outline script:
#POST_SUMMARY_HOOK="${HOME}/.local/bin/hushnote-to-outline"

# Notification command override. By default hushnote uses dunstify (if available)
# with replace-by-ID so reminders update in place, falling back to notify-send.
# Set this to use a different notifier, e.g. mako, fnott, or a custom script.
# Will be called as: $NOTIFY_CMD "summary" "body"
#NOTIFY_CMD=notify-send

# Speaker diarization.
# Default: auto, which runs diarization when HF_TOKEN is set.
# In unattended runs, speaker names are not prompted and SPEAKER_00-style IDs are used.
#HUSHNOTE_DIARIZE=auto
#HUSHNOTE_LABEL_SPEAKERS=auto

# HuggingFace API token, required for speaker diarization with pyannote models.
# Prefer exporting this from a secret manager or shell profile instead of committing it here.
# Create a token at https://huggingface.co/settings/tokens
# Accept model conditions at https://huggingface.co/pyannote/speaker-diarization-3.1
#HF_TOKEN=${HF_TOKEN:-}
